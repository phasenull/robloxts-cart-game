{
	"compilerOptions": {
		// required
		"allowSyntheticDefaultImports": true,
		"downlevelIteration": true,
		"jsx": "react",
		"jsxFactory": "React.createElement",
		"jsxFragmentFactory": "React.Fragment",
		"module": "commonjs",
		"moduleResolution": "Node",
		"noLib": true,
		"resolveJsonModule": true,
		"experimentalDecorators": true,
		"forceConsistentCasingInFileNames": true,
		"moduleDetection": "force",
		"strict": true,
		"target": "ESNext",
		// Every npm scope the game imports from must be a type root (roblox-ts rule).
		"typeRoots": ["node_modules/@rbxts", "node_modules/@typetorch"],
		// Explicit global types: otherwise TypeScript auto-includes every folder in the type roots, and
		// @typetorch/kernel (Luau only, no typings) fails with TS2688.
		"types": ["types", "compiler-types"],
		// configurable
		"rootDir": "src",
		"paths": { "*": ["./src/*"] },
		"outDir": "out",
		"incremental": true,
		"tsBuildInfoFile": "out/tsconfig.tsbuildinfo",
		// Order matters: debug macros first, then @typetorch/transformer (guards for createNetwork, DI ids for
		// @Service/@Controller, user macros written with Modding).
		"plugins": [
			{
				"transform": "rbxts-transform-debug",
				"environmentRequires": {}
			},
			{ "transform": "@typetorch/transformer" }
		]
	},
	// Only the three payload realms (.ts and .tsx): never scripts/. The old src/common submodule was removed; the files
	// the game used are vendored into src/{client,shared}/common.
	"include": ["./src/server", "./src/shared", "./src/client"]
}
