{
    "openapi": "3.0.0",
    "info": {
        "title": "Cart Game Backend API",
        "version": "1.0.0"
    },
    "components": {
        "securitySchemes": {
            "Bearer": {
                "type": "http",
                "scheme": "bearer",
                "bearerFormat": "JWT",
                "description": "Enter your JWT token"
            }
        },
        "schemas": {},
        "parameters": {}
    },
    "paths": {
        "/admin/sign": {
            "post": {
                "tags": [
                    "Admin"
                ],
                "requestBody": {
                    "description": "Admin credentials",
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "username": {
                                        "type": "string"
                                    },
                                    "password": {
                                        "type": "string"
                                    },
                                    "age": {
                                        "type": "integer",
                                        "minimum": 0,
                                        "exclusiveMinimum": true,
                                        "default": 7,
                                        "description": "JWT expiry in days"
                                    }
                                },
                                "required": [
                                    "username",
                                    "password"
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "JWT token generated successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "token": {
                                            "type": "string"
                                        },
                                        "expires_at": {
                                            "type": "number",
                                            "description": "Unix timestamp in milliseconds"
                                        }
                                    },
                                    "required": [
                                        "token",
                                        "expires_at"
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Invalid credentials",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "error": {
                                            "type": "string"
                                        }
                                    },
                                    "required": [
                                        "error"
                                    ]
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Server error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "error": {
                                            "type": "string"
                                        }
                                    },
                                    "required": [
                                        "error"
                                    ]
                                }
                            }
                        }
                    }
                }
            }
        },
        "/leaderboard/get-player": {
            "get": {
                "tags": [
                    "Leaderboard"
                ],
                "security": [
                    {
                        "Bearer": []
                    }
                ],
                "parameters": [
                    {
                        "schema": {
                            "anyOf": [
                                {
                                    "type": "integer"
                                },
                                {
                                    "type": "string"
                                }
                            ]
                        },
                        "required": true,
                        "name": "user_id",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Player found successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "player": {
                                            "type": "object",
                                            "properties": {
                                                "user_id": {
                                                    "type": "integer",
                                                    "minimum": -9007199254740991,
                                                    "maximum": 9007199254740991
                                                },
                                                "created_at": {
                                                    "type": "string",
                                                    "format": "date-time"
                                                },
                                                "updated_at": {
                                                    "type": "string",
                                                    "nullable": true,
                                                    "format": "date-time"
                                                },
                                                "cash": {
                                                    "type": "integer",
                                                    "minimum": -9007199254740991,
                                                    "maximum": 9007199254740991
                                                },
                                                "playtime": {
                                                    "type": "integer",
                                                    "minimum": -9007199254740991,
                                                    "maximum": 9007199254740991
                                                },
                                                "robux_spent": {
                                                    "type": "integer",
                                                    "minimum": -9007199254740991,
                                                    "maximum": 9007199254740991
                                                }
                                            },
                                            "required": [
                                                "user_id",
                                                "created_at",
                                                "updated_at",
                                                "cash",
                                                "playtime",
                                                "robux_spent"
                                            ]
                                        },
                                        "ranks": {
                                            "type": "object",
                                            "properties": {
                                                "cash": {
                                                    "type": "number"
                                                },
                                                "playtime": {
                                                    "type": "number"
                                                },
                                                "robux_spent": {
                                                    "type": "number"
                                                }
                                            },
                                            "required": [
                                                "cash",
                                                "playtime",
                                                "robux_spent"
                                            ]
                                        }
                                    },
                                    "required": [
                                        "player",
                                        "ranks"
                                    ]
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "error": {
                                            "type": "string"
                                        }
                                    },
                                    "required": [
                                        "error"
                                    ]
                                }
                            }
                        }
                    }
                }
            }
        },
        "/leaderboard/update-player": {
            "post": {
                "tags": [
                    "Leaderboard"
                ],
                "security": [
                    {
                        "Bearer": []
                    }
                ],
                "requestBody": {
                    "description": "Player data to update",
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "user_id": {
                                        "type": "integer",
                                        "minimum": -9007199254740991,
                                        "maximum": 9007199254740991
                                    },
                                    "cash": {
                                        "type": "integer",
                                        "minimum": -9007199254740991,
                                        "maximum": 9007199254740991
                                    },
                                    "playtime": {
                                        "type": "integer",
                                        "minimum": -9007199254740991,
                                        "maximum": 9007199254740991
                                    },
                                    "robux_spent": {
                                        "type": "integer",
                                        "minimum": -9007199254740991,
                                        "maximum": 9007199254740991
                                    }
                                },
                                "required": [
                                    "user_id",
                                    "cash",
                                    "playtime",
                                    "robux_spent"
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Player updated successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "default": true
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "error": {
                                            "type": "string"
                                        }
                                    },
                                    "required": [
                                        "error"
                                    ]
                                }
                            }
                        }
                    }
                }
            }
        },
        "/leaderboard/list": {
            "get": {
                "tags": [
                    "Leaderboard"
                ],
                "security": [
                    {
                        "Bearer": []
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Leaderboard lists retrieved successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "cash": {
                                            "type": "array",
                                            "items": {
                                                "type": "object",
                                                "properties": {
                                                    "user_id": {
                                                        "type": "number"
                                                    },
                                                    "cash": {
                                                        "type": "number"
                                                    }
                                                },
                                                "required": [
                                                    "user_id",
                                                    "cash"
                                                ]
                                            },
                                            "maxItems": 100
                                        },
                                        "playtime": {
                                            "type": "array",
                                            "items": {
                                                "type": "object",
                                                "properties": {
                                                    "user_id": {
                                                        "type": "number"
                                                    },
                                                    "playtime": {
                                                        "type": "number"
                                                    }
                                                },
                                                "required": [
                                                    "user_id",
                                                    "playtime"
                                                ]
                                            },
                                            "maxItems": 100
                                        },
                                        "robux_spent": {
                                            "type": "array",
                                            "items": {
                                                "type": "object",
                                                "properties": {
                                                    "user_id": {
                                                        "type": "number"
                                                    },
                                                    "robux_spent": {
                                                        "type": "number"
                                                    }
                                                },
                                                "required": [
                                                    "user_id",
                                                    "robux_spent"
                                                ]
                                            },
                                            "maxItems": 100
                                        }
                                    },
                                    "required": [
                                        "cash",
                                        "playtime",
                                        "robux_spent"
                                    ]
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}